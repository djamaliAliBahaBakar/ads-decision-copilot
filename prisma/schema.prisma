generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(cuid())
  clerkId             String        @unique
  email               String        @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  onboardingCompleted Boolean       @default(false)
  ads                 Ad[]
  decisions           Decision[]
  emailDigests        EmailDigest[]
  metaAccount         MetaAccount?
  subscription        Subscription?
  rules               UserRule[]
}

model Ad {
  id             String     @id @default(cuid())
  userId         String
  adName         String
  campaignName   String?
  adSetName      String?
  angle          String?
  cpl            Float
  spend          Float
  leads          Int
  ctr            Float?
  roas           Float?
  date           DateTime
  weekNumber     Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  metaAdId       String?
  metaCampaignId String?
  impressions    Int?
  clicks         Int?
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions      Decision[]

  @@unique([userId, metaAdId])
  @@index([userId, date])
  @@index([userId, angle])
}

model Decision {
  id              String    @id @default(cuid())
  userId          String
  adId            String
  action          String
  reason          String
  hypothesis      String?
  expectedEffect  String?
  confidence      Int?
  cplAtDecision   Float
  cplTrend3d      Float?
  daysRunning     Int?
  actualSavings   Float?
  wasCorrect      Boolean?
  postMortemNotes String?
  resultFilledAt  DateTime?
  followedRule    Boolean?
  appliedRuleId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  ad              Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserRule {
  id          String   @id @default(cuid())
  userId      String
  ruleType    String
  threshold   Float
  days        Int
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model MetaAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  accountId    String
  accountName  String?
  lastSyncAt   DateTime?
  syncStatus   String    @default("idle")
  syncError    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailDigest {
  id              String    @id @default(cuid())
  userId          String
  weekStartDate   DateTime
  weekEndDate     DateTime
  disciplineScore Float
  economiesSaved  Float
  bestDecision    String?
  worstDecision   String?
  cplTrend        Float?
  topInsight      String?
  sentAt          DateTime?
  openedAt        DateTime?
  isEnabled       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStartDate])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  accessLevel          AccessLevel        @default(FREE_PREVIEW)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  plan                 String?
  amount               Int?
  currency             String             @default("eur")
  isEarlyAdopter       Boolean            @default(false)
  earlyAdopterUntil    DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
}

enum AccessLevel {
  FREE_PREVIEW
  PAID
  SUPERUSER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}
