generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USERS
// ============================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaAccount MetaAccount?
  onboardingCompleted Boolean @default(false)

  emailDigests EmailDigest[]
  subscription Subscription?

  ads       Ad[]
  decisions Decision[]
  rules     UserRule[]
}

// ============================================
// ADS DATA
// ============================================

model Ad {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  adName       String
  campaignName String?
  angle        String?  // PROBLEME, MECANISME, PREUVE, etc.
  
  cpl          Float
  spend        Float
  leads        Int
  ctr          Float?
  roas         Float?
  
  date         DateTime
  weekNumber   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  decisions    Decision[]

   // Meta sync fields
  metaAdId       String?  // Facebook Ad ID
  metaCampaignId String?  // Facebook Campaign ID
  impressions    Int?
  clicks         Int?
  
  @@unique([userId, metaAdId])
  @@index([userId, date])
  @@index([userId, angle])
}

// ============================================
// DECISIONS
// ============================================

model Decision {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  
  action    String   // KILL, SCALE, HOLD, TEST, FIX
  reason    String   @db.Text
  hypothesis String?  @db.Text
  expectedEffect String? @db.Text
  confidence Int?    // 1-5
  
  cplAtDecision Float
  cplTrend3d    Float?
  daysRunning   Int?
  
  actualSavings Float?
  wasCorrect    Boolean?
  postMortemNotes String? @db.Text
  resultFilledAt DateTime?

    // TILTMETER : suivi discipline
  followedRule  Boolean?  // user a-t-il suivi une règle applicable ?
  appliedRuleId String?   // laquelle ?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, createdAt])
}

// ============================================
// USER RULES (pour Tiltmeter)
// ============================================

model UserRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  ruleType  String   // "kill_if_cpl", "scale_if_roas", etc.
  threshold Float
  days      Int
  isActive  Boolean  @default(true)

  // Human-readable
  description String? // "Kill si CPL > €10 pendant 3j"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, isActive])
}

model MetaAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Meta credentials
  accessToken String    // Encrypted in production
  refreshToken String?   
  accountId   String     // Meta Ad Account ID
  accountName String?
  
  // Sync tracking
  lastSyncAt  DateTime?
  syncStatus  String    @default("idle") // idle, syncing, error
  syncError   String?
  
  // Permissions
  isActive    Boolean   @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

model EmailDigest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Digest data
  weekStartDate DateTime
  weekEndDate   DateTime

  disciplineScore Float
  economiesSaved  Float
  bestDecision    String?
  worstDecision   String?
  cplTrend        Float?
  topInsight      String?

  // Email tracking
  sentAt    DateTime?
  openedAt  DateTime?

  // Settings
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, weekStartDate])
}

// ============================================
// SUBSCRIPTIONS & ACCESS
// ============================================

enum AccessLevel {
  FREE_PREVIEW
  PAID
  SUPERUSER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Access level
  accessLevel AccessLevel @default(FREE_PREVIEW)

  // Stripe data
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?

  // Subscription status
  status         SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean @default(false)

  // Billing
  plan           String?  // "monthly" | "quarterly"
  amount         Int?     // in cents (2900 = 29€)
  currency       String   @default("eur")

  // Trial / Early adopter
  isEarlyAdopter Boolean @default(false)
  earlyAdopterUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}